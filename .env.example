# Copy this file to .env for local development on the host. Never commit .env.
# Inside the NemoClaw sandbox, the OpenShell gateway holds the keys, so the
# agent only ever sees placeholders (see docs/phase1-nemoclaw.md).

# Nebius Token Factory
TOKENFACTORY_API_KEY=
TOKENFACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model ids exactly as GET /v1/models lists them. They are case sensitive.
KEEPER_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
KEEPER_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
KEEPER_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily, for the opportunity radar
TAVILY_API_KEY=

# Telegram bot token from BotFather, and the chat Keeper posts summaries to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth for the demo Gmail account and its calendar. Never your real inbox.
GOOGLE_OAUTH_CLIENT_FILE=./secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=./secrets/google_token.json

# Where Keeper keeps memory, skills and the router call log.
# In the sandbox this points under /sandbox so it survives restarts.
KEEPER_DATA_DIR=./data
KEEPER_TIMEZONE=America/Los_Angeles

# Schedules
KEEPER_TRIAGE_INTERVAL_MIN=30
KEEPER_RADAR_DAILY_AT=08:00
